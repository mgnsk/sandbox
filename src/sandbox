class SandboxError(Exception):
    """A reason not to start, printed as `sandbox: <message>`."""


# -- paths ------------------------------------------------------------------


def expand(value, variables):
    """value with a leading ~ and $VAR/${VAR} references from variables
    expanded; unknown variables are left as they are."""
    if value == "~" or value.startswith("~/"):
        value = "$HOME" + value[1:]
    return Template(value).safe_substitute(variables)


def check_cwd(cwd, home):
    """Refuse directories the read-write project bind must never cover."""
    # $PWD is bound read-write; in ~ (or above it) that would be the whole
    # host home over the volume.
    if f"{home}/".startswith(f"{cwd.rstrip('/')}/"):
        raise SandboxError(f"refusing to run in {cwd}, it contains $HOME")
    # The dot directories directly under ~ hold host state no sandbox should
    # write: ssh keys and config, every sandbox's volume, secrets and
    # exchange dir, the gh token, an ssh agent socket, ...
    if f"{cwd}/".startswith(f"{home}/."):
        raise SandboxError(f"refusing to run in {cwd}, it is host state under $HOME")


def check_outside(cwd, state_dir):
    """The state dir holds every sandbox's volume and secrets."""
    if f"{cwd}/".startswith(f"{state_dir.rstrip('/')}/") or f"{state_dir}/".startswith(
        f"{cwd}/"
    ):
        raise SandboxError(
            f"refusing to run in {cwd}, it overlaps the sandbox state dir {state_dir}"
        )


def project_root(cwd):
    """The enclosing git work tree's top level (where .git is, as a directory
    or a worktree's file), or cwd itself outside one.

    Found by looking, not by running git: git on the host reads the repo's
    config, which the sandbox can write.
    """
    path = Path(cwd)
    for candidate in (path, *path.parents):
        if (candidate / ".git").exists():
            return str(candidate)
    return cwd


def volume_name(project):
    """Per-project name: the path made flat, plus a hash so that flattening
    can't make two projects collide."""
    digest = hashlib.sha256(project.encode()).hexdigest()[:8]
    return project.replace("/", "_") + f"-{digest}"


# -- host ports -------------------------------------------------------------

HOST_PORT_RE = re.compile(r"^([0-9]{1,5})(-([0-9]{1,5}))?(/(tcp|udp))?$")


def parse_host_ports(specs):
    """(tcp, udp) port lists for pasta's -T/-U from entries like 5037,
    8080/udp or 9000-9010."""
    tcp, udp = [], []
    for spec in specs:
        m = HOST_PORT_RE.match(spec)
        if not m:
            raise SandboxError(
                f"bad SANDBOX_HOST_PORTS entry '{spec}' (want PORT[-PORT][/tcp|/udp])"
            )
        first = int(m.group(1))
        last = int(m.group(3) or first)
        if first < 1 or last > 65535 or last < first:
            raise SandboxError(
                f"bad SANDBOX_HOST_PORTS range '{spec}' (ports are 1-65535)"
            )
        ports = str(first) if first == last else f"{first}-{last}"
        (udp if m.group(5) == "udp" else tcp).append(ports)
    return tcp, udp


def host_port_specs(configured, environ):
    """The configured ports plus SANDBOX_HOST_PORTS from the host's
    environment - never from inside, since --clearenv keeps it out."""
    return [
        *configured,
        *environ.get("SANDBOX_HOST_PORTS", "").replace(",", " ").split(),
    ]


# -- profiles ---------------------------------------------------------------


def select_profile(config, cwd, project, variables):
    """The highest-priority profile matching cwd (by path prefix) or the
    project (by a file in its root), else the default one."""
    best = None
    for profile in config["profiles"]:
        paths = [expand(p, variables).rstrip("/") for p in profile["paths"]]
        matches = any(f"{cwd}/".startswith(f"{p}/") for p in paths) or any(
            os.path.lexists(os.path.join(project, f)) for f in profile["projectFiles"]
        )
        if matches and (best is None or profile["priority"] > best["priority"]):
            best = profile
    return best or config["default"]


# -- your config (~/.config/sandbox/config.nix) -----------------------------

USER_CONFIG_FILE = "config.nix"


def is_within(path, dir):
    return f"{path}/".startswith(f"{dir.rstrip('/')}/")


def user_config_files(config_dir):
    """Every file under the config dir (through symlinks to files, which
    dotfiles managers make), sorted: what the cache key covers."""
    files = []
    for root, dirs, names in os.walk(config_dir):
        dirs.sort()
        files += [
            os.path.join(root, n)
            for n in sorted(names)
            if os.path.isfile(os.path.join(root, n))
        ]
    return files


def build_user_config(user_config, file, link):
    """nix-build user.nix on the file, with a GC root at link; its store path."""
    nix_build = shutil.which("nix-build")
    if not nix_build:
        raise SandboxError(f"building {file} needs nix-build on PATH")
    argv = [
        nix_build, user_config["eval"],
        "--argstr", "nixpkgs", user_config["nixpkgs"],
        "--argstr", "system", user_config["system"],
        "--argstr", "file", file,
        "--out-link", link,
    ]  # fmt: skip
    print(f"sandbox: building {file}", file=sys.stderr)
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
    except KeyboardInterrupt:
        raise SandboxError(f"building {file} interrupted") from None
    outs = [line for line in result.stdout.splitlines() if is_store_path(line)]
    if result.returncode != 0 or not outs:
        raise SandboxError(f"building {file} failed")
    return outs[-1]


def user_config(config, config_path, environ, home, project, reload, build=None):
    """The config to run with: the one built from ~/.config/sandbox/config.nix
    when this sandbox takes one and it exists, else this one. Cached until a
    file in ~/.config/sandbox or this sandbox changes; imports from outside
    that dir aren't tracked, --reload picks them up."""
    if not config.get("userConfig"):
        return config_path, config
    config_dir = os.path.join(
        environ.get("XDG_CONFIG_HOME") or f"{home}/.config", "sandbox"
    )
    file = os.path.join(config_dir, USER_CONFIG_FILE)
    if not os.path.isfile(file):
        return config_path, config
    files = user_config_files(config_dir)
    # It's built and run on the host: not from anywhere a sandbox can write.
    for path in [config_dir, *files]:
        real = os.path.realpath(path)
        if is_within(real, project):
            raise SandboxError(
                f"refusing to use {file}: {real} is in this project, which the sandbox can write"
            )
    digest = hashlib.sha256(os.path.realpath(config_path).encode())
    for path in files:
        digest.update(json.dumps(os.path.relpath(path, config_dir)).encode())
        digest.update(hashlib.sha256(Path(path).read_bytes()).digest())
    key = digest.hexdigest()

    state = os.path.join(
        environ.get("XDG_STATE_HOME") or f"{home}/.local/state", "sandbox"
    )
    os.makedirs(state, exist_ok=True)
    cache = os.path.join(state, "config.json")
    out = None
    if not reload:
        try:
            cached = json.loads(Path(cache).read_text(encoding="utf-8"))
            if (
                cached["key"] == key
                and is_store_path(cached["config"])
                and os.path.isfile(cached["config"])
            ):
                out = cached["config"]
        except (OSError, ValueError, KeyError, TypeError):
            pass
    if out is None:
        build = build or build_user_config
        out = build(config["userConfig"], file, os.path.join(state, "config"))
        write_json(cache, {"key": key, "config": out})
    try:
        built = json.loads(Path(out).read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise SandboxError(f"can't read the {file} result {out}: {e}") from None
    if not isinstance(built, dict) or built.get("userConfig") is not None:
        raise SandboxError(f"bad {file} result {out}")
    return out, built


# -- project config (sandbox.nix) -------------------------------------------

PROJECT_FILE = "sandbox.nix"
STORE_PATH_RE = re.compile(r"^/nix/store/[0-9a-z]{32}-[^/]+(/[^/]+)*$")


def parse_options(args):
    """The launcher's own leading options, and the command after them."""
    options = {
        "reload": False,
        "projectConfig": True,
        "claudeApiKey": False,
        "ghToken": False,
        "fjToken": None,
    }
    while args and args[0].startswith("--"):
        arg, args = args[0], args[1:]
        if arg == "--":
            break
        if arg == "--reload":
            options["reload"] = True
        elif arg == "--no-project-config":
            options["projectConfig"] = False
        elif arg == "--claude-api-key":
            options["claudeApiKey"] = True
        elif arg == "--gh-token":
            options["ghToken"] = True
        elif arg == "--fj-token":
            if not args or args[0].startswith("--"):
                raise SandboxError(
                    "--fj-token needs the Forgejo host, e.g. --fj-token codeberg.org"
                )
            options["fjToken"], args = forgejo_host(args[0]), args[1:]
        else:
            raise SandboxError(
                f"unknown option {arg} (put -- before a command starting with --)"
            )
    return options, args


def is_store_path(value):
    return (
        isinstance(value, str)
        and STORE_PATH_RE.match(value) is not None
        and not any(part in (".", "..") for part in value.split("/"))
    )


def _is_str_list(value):
    return isinstance(value, list) and all(isinstance(v, str) for v in value)


def _is_bind(value):
    return (
        isinstance(value, dict)
        and set(value) == {"src", "dst", "mode", "optional", "hideGit"}
        and isinstance(value["src"], str)
        and (value["dst"] is None or isinstance(value["dst"], str))
        and value["mode"] in ("ro", "rw")
        and isinstance(value["optional"], bool)
        and isinstance(value["hideGit"], bool)
    )


MANIFEST_FIELDS = {
    "claudeDir": lambda v: v is None or is_store_path(v),
    "binds": lambda v: isinstance(v, list) and all(_is_bind(b) for b in v),
    "hostPorts": _is_str_list,
    "command": lambda v: v is None or (_is_str_list(v) and len(v) > 0),
}


def read_manifest(path):
    """What project.nix made of sandbox.nix. It comes out of a sandbox, so
    every field is checked before the launcher uses it."""
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise SandboxError(
            f"can't read the {PROJECT_FILE} result {path}: {e}"
        ) from None
    if not isinstance(data, dict) or set(data) != set(MANIFEST_FIELDS):
        raise SandboxError(f"bad {PROJECT_FILE} result {path}")
    for name, valid in MANIFEST_FIELDS.items():
        if not valid(data[name]):
            raise SandboxError(f"bad {PROJECT_FILE} result {path}: {name}")
    return data


def read_project_file(path):
    """sandbox.nix's bytes, for the cache key. Not through a symlink, which
    would have the launcher read a host file of the sandbox's choosing."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as e:
        raise SandboxError(
            f"can't read {path}: {e.strerror} (it must be a regular file)"
        ) from None
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise SandboxError(f"{path} must be a regular file")
        return f.read()


def write_json(path, value):
    """Atomically, into a directory only the host can write."""
    tmp = f"{path}.tmp"
    Path(tmp).write_text(
        json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    os.replace(tmp, path)


def evaluate_project(config, config_path, project_file, base):
    """Build sandbox.nix's manifest with nix inside a sandbox of the project
    (without its sandbox.nix), and return its store path."""
    project = config["project"]
    argv = [
        config["python"], "-E", "-s", os.path.join(config["src"], "sandbox"), config_path,
        "--no-project-config", "--",
        "nix", "build", "--no-link", "--print-out-paths", "--file", project["eval"],
        "--argstr", "nixpkgs", project["nixpkgs"],
        "--argstr", "system", project["system"],
        "--argstr", "file", project_file,
        "--argstr", "base", base or "",
    ]  # fmt: skip
    print(f"sandbox: evaluating {project_file}", file=sys.stderr)
    try:
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
    except KeyboardInterrupt:
        raise SandboxError(f"evaluating {project_file} interrupted") from None
    if result.returncode != 0:
        raise SandboxError(f"evaluating {project_file} failed")
    # The login shell's startup files may print too; the build's output is
    # the last line.
    outs = [line for line in result.stdout.splitlines() if is_store_path(line)]
    if not outs:
        raise SandboxError(f"evaluating {project_file} gave no result")
    return outs[-1]


def project_manifest(
    config, config_path, project, volume_dir, base, reload, evaluate=evaluate_project
):
    """sandbox.nix's manifest, from the cache while sandbox.nix, the
    sandbox's own config and the profile's Claude config are unchanged.
    Files sandbox.nix imports aren't tracked; --reload picks them up."""
    project_file = os.path.join(project, PROJECT_FILE)
    content = read_project_file(project_file)
    key = hashlib.sha256(
        json.dumps([os.path.realpath(config_path), base or "", content.hex()]).encode()
    ).hexdigest()
    cache = os.path.join(volume_dir, "project.json")
    if not reload:
        try:
            cached = json.loads(Path(cache).read_text(encoding="utf-8"))
            if (
                cached["key"] == key
                and is_store_path(cached["manifest"])
                and os.path.isfile(cached["manifest"])
            ):
                return read_manifest(cached["manifest"])
        except (OSError, ValueError, KeyError, TypeError):
            pass
    out = evaluate(config, config_path, project_file, base)
    manifest = read_manifest(out)
    write_json(cache, {"key": key, "manifest": out})
    return manifest


def host_access(manifest):
    """What sandbox.nix asks for beyond the inside of the sandbox."""
    return {"binds": manifest["binds"], "hostPorts": manifest["hostPorts"]}


def describe_host_access(access):
    lines = []
    for b in access["binds"]:
        dst = f" at {b['dst']}" if b["dst"] else ""
        extra = ", optional" if b["optional"] else ""
        lines.append(
            f"  bind {b['src']}{dst} ({'read-write' if b['mode'] == 'rw' else 'read-only'}{extra})"
        )
    lines += [f"  host port {p}" for p in access["hostPorts"]]
    return "\n".join(lines)


def open_tty():
    """The controlling terminal, also when stdin/stdout are redirected."""
    return open("/dev/tty", "r+", encoding="utf-8")


def approve_project(manifest, volume_dir, project_file, open_tty=open_tty):
    """Binds and host ports from sandbox.nix need a yes on the terminal,
    again whenever they change: the sandbox can edit sandbox.nix, so its
    say-so alone must never widen the next sandbox. The approval is stored
    in the volume dir, out of the sandbox's reach."""
    access = host_access(manifest)
    if not access["binds"] and not access["hostPorts"]:
        return
    approved_file = os.path.join(volume_dir, "project-approved.json")
    try:
        if json.loads(Path(approved_file).read_text(encoding="utf-8")) == access:
            return
    except (OSError, ValueError):
        pass
    text = f"sandbox: {project_file} asks for host access:\n{describe_host_access(access)}\n"
    try:
        tty = open_tty()
    except OSError:
        raise SandboxError(
            f"{project_file} asks for host access that isn't approved yet; start the sandbox from a terminal to approve it"
        ) from None
    with tty:
        tty.write(text + "Allow? [y/N] ")
        tty.flush()
        answer = tty.readline().strip().lower()
    if answer not in ("y", "yes"):
        raise SandboxError("host access not approved, not starting")
    write_json(approved_file, access)


def read_secret(tty, prompt):
    """A line from tty without echoing it, when tty is a terminal."""
    tty.write(prompt)
    tty.flush()
    try:
        fd = tty.fileno()
        old = termios.tcgetattr(fd)
    except (OSError, ValueError, termios.error):
        fd = old = None  # Not a terminal (tests): read it plainly.
    if old is not None:
        new = list(old)
        new[3] &= ~termios.ECHO
        termios.tcsetattr(fd, termios.TCSAFLUSH, new)
    try:
        return tty.readline().strip()
    finally:
        if old is not None:
            termios.tcsetattr(fd, termios.TCSAFLUSH, old)
            tty.write("\n")
            tty.flush()


CLAUDE_API_KEY_RE = re.compile(r"^[A-Za-z0-9_-]{20,512}$")


def claude_api_key(volume_dir, ask_again, open_tty=None):
    """The file for the project's Claude API key, asking for the key on the
    terminal when there's none yet (or ask_again). It's in the volume dir,
    out of the sandbox's reach; claude-api-proxy reads it per request, so a
    key set later reaches a running sandbox."""
    key_file = os.path.join(volume_dir, "claude-api-key")
    if os.path.exists(key_file) and not ask_again:
        return key_file
    try:
        tty = (open_tty or globals()["open_tty"])()
    except OSError:
        print(
            "sandbox: no Claude API key for this project yet - run `sandbox --claude-api-key` from a terminal",
            file=sys.stderr,
        )
        return key_file
    with tty:
        tty.write(
            "sandbox: Claude Code here uses an API key that stays outside the sandbox.\n"
            "Create one for this project at https://platform.claude.com/settings/keys\n"
            "(a workspace with a spend limit caps what a misbehaving sandbox can spend).\n"
        )
        key = read_secret(tty, "API key (Enter to skip): ")
        if key and not CLAUDE_API_KEY_RE.match(key):
            tty.write("sandbox: that doesn't look like an API key, not saved\n")
            key = ""
        if not key:
            if not os.path.exists(key_file):
                tty.write(
                    "sandbox: no key - Claude Code inside can't reach the API until `sandbox --claude-api-key` sets one\n"
                )
            return key_file
    write_secret(key_file, key + "\n")
    return key_file


def write_secret(path, text):
    """Replace the file at path (in a volume dir, never in the home volume
    the sandbox writes) with text, readable only by the user."""
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


# Like api_proxy.TOKEN_RE: no whitespace or control characters.
TOKEN_RE = re.compile(r"^[A-Za-z0-9_.~+/=-]{8,1024}$")
FORGEJO_HOST_RE = re.compile(r"^[a-z0-9.-]+(:[0-9]+)?$")
GITHUB_TOKEN_FILE = "github-token"
FORGEJO_TOKENS_FILE = "forgejo-tokens.json"


def forgejo_host(value):
    """host[:port] from a host or an instance URL."""
    host = re.sub(r"^https?://", "", value.strip().lower()).split("/", 1)[0]
    host = host.removesuffix(":443")
    if not FORGEJO_HOST_RE.match(host):
        raise SandboxError(f"not a Forgejo host: {value}")
    return host


def ask_token(intro, prompt, open_tty=None):
    """A token read on the terminal (hidden input); "" when skipped or
    malformed."""
    if os.environ.get("SANDBOX_EXCHANGE"):
        # Only a hint, not a control: in here it would land in this
        # sandbox's volume, where no proxy reads it.
        raise SandboxError(
            "this is inside a sandbox - set the token on the host, in the project"
        )
    try:
        tty = (open_tty or globals()["open_tty"])()
    except OSError:
        raise SandboxError(
            "setting a token needs a terminal - run it in one on the host, in the project"
        ) from None
    with tty:
        tty.write(intro)
        token = read_secret(tty, prompt)
        if token and not TOKEN_RE.match(token):
            tty.write("sandbox: that doesn't look like a token, not saved\n")
            return ""
        if not token:
            tty.write("sandbox: nothing changed\n")
        return token


def set_github_token(volume_dir, open_tty=None):
    """Ask for the project's GitHub token and keep it in the volume dir, out
    of the sandbox's reach; gh-api-proxy prefers it to the host gh's."""
    token = ask_token(
        "sandbox: gh in this project uses a token that stays outside the sandbox.\n"
        "Create a fine-grained token limited to this project's repositories at\n"
        "https://github.com/settings/personal-access-tokens/new\n"
        "(a token, not a `gh auth login`: GitHub caps how many OAuth logins stay valid).\n",
        "GitHub token (Enter to keep the current one): ",
        open_tty,
    )
    if token:
        write_secret(os.path.join(volume_dir, GITHUB_TOKEN_FILE), token + "\n")


def set_forgejo_token(volume_dir, host, open_tty=None):
    """Ask for the project's token for the Forgejo instance at host and add
    it to the volume dir's {host: token} file; forgejo-api-proxy prefers it
    to the host fj's."""
    token = ask_token(
        f"sandbox: fj in this project uses a token for {host} that stays outside the sandbox.\n"
        f"Create one at https://{host}/user/settings/applications\n",
        f"Token for {host} (Enter to keep the current one): ",
        open_tty,
    )
    if not token:
        return
    path = os.path.join(volume_dir, FORGEJO_TOKENS_FILE)
    try:
        tokens = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        tokens = {}
    if not isinstance(tokens, dict):
        tokens = {}
    tokens[host] = token
    write_secret(path, json.dumps(tokens, indent=2, sort_keys=True) + "\n")


def apply_project(profile, manifest):
    """The profile with sandbox.nix's additions: its binds on top, and its
    Claude config (already merged with the profile's by project.nix) in place
    of the profile's. Tools and variables are the project's dev shell's
    business (flake, devenv), not the sandbox's."""
    return {
        **profile,
        "binds": profile["binds"] + manifest["binds"],
        "claudeDir": (manifest["claudeDir"] or profile["claudeDir"])
        if profile["claudeDir"]
        else None,
    }


# -- bwrap arguments --------------------------------------------------------


def bind_args(binds, variables, project):
    """bwrap args for the profile's extra binds and the project."""
    args = []
    for bind in binds:
        src = os.path.realpath(expand(bind["src"], variables))
        dst = expand(bind["dst"], variables) if bind["dst"] else src
        if src == project and dst == src:
            # The project bind below covers it, read-write and .git included:
            # a repo bound for reference elsewhere is the project here.
            continue
        flag = "--bind" if bind["mode"] == "rw" else "--ro-bind"
        args += [flag + ("-try" if bind["optional"] else ""), src, dst]
        if bind["hideGit"] and os.path.isdir(os.path.join(src, ".git")):
            # Its history, with whatever was ever committed and removed
            # again, is none of another project's business.
            args += ["--tmpfs", os.path.join(dst, ".git")]
    # The whole work tree rather than just $PWD, so starting in a
    # subdirectory still gets .git.
    args += ["--bind", project, project]
    return args


def base_args(config, env):
    """Namespaces, environment and the filesystem every sandbox has."""
    fhs = config["fhs"]
    args = [
        # Includes --unshare-pid, so a sandbox shows up as two bwrap processes
        # on the host: the outer one waits in the host's pid namespace to relay
        # the exit status, the inner one is pid 1 inside, reaping zombies and
        # forwarding signals.
        "--unshare-all",
        "--unshare-user",
        "--disable-userns",
        # pasta maps the invoking user to uid 0 in its own userns; pin the
        # real uid/gid so bwrap doesn't inherit that and look like real root.
        "--uid", str(os.getuid()),
        "--gid", str(os.getgid()),
        # Retains the netns bwrap starts in - a fresh one from pasta, not the
        # host's. Sharing the host's would also expose its abstract AF_UNIX
        # namespace (e.g. @/tmp/.X11-unix/X0, which Xwayland accepts
        # unauthenticated local connections on).
        "--share-net",
        "--die-with-parent",
        "--cap-drop", "ALL",
        # Otherwise the host env passes through untouched, e.g. a GitHub token
        # in the host shell would reach the API directly, bypassing the gh
        # write popups.
        "--clearenv",
    ]  # fmt: skip
    for name, value in env.items():
        args += ["--setenv", name, value]

    args += [
        "--dev", "/dev",
        "--proc", "/proc",
        "--tmpfs", "/tmp",
        "--tmpfs", env["XDG_RUNTIME_DIR"],
        # Read-only is enough for builds to land in the host store: the
        # daemon socket stays connectable on a ro mount, and the host's
        # nix-daemon does the actual store writes.
        "--ro-bind", "/nix", "/nix",
        # Nothing of the host's /usr, /bin or /lib: the few fixed paths
        # programs expect, from the store.
        "--ro-bind", fhs["bin"], "/bin",
        "--ro-bind", fhs["usrBin"], "/usr/bin",
        "--ro-bind", fhs["nixLd"], fhs["ldPath"],
        "--ro-bind", fhs["ssl"], "/etc/ssl",
    ]  # fmt: skip
    for path in config["hostEtc"]:
        args += ["--ro-bind-try", path, path]
    return args


# -- guards -----------------------------------------------------------------


class Guards:
    """Host-side guard processes and their temp dirs, torn down on close.

    An "always" answer to any guard's popup lives in that guard's memory, so
    it ends with this sandbox.
    """

    def __init__(self, config):
        self.config = config
        self.procs = []
        self.dirs = []
        # Host loopback ports pasta maps in (-T), and CA certificates the
        # gh/fj wrappers trust, from the HTTPS-intercepting guards.
        self.tcp_ports = []
        self.ca_certs = []
        self.env = dict(os.environ)
        # gh, xdg-open, ... from the store first; the host's PATH after,
        # for what xdg-open hands URLs to (the browser).
        self.env["PATH"] = config["hostPath"] + ":" + os.environ.get("PATH", "")
        self.env.pop("PYTHONPATH", None)

    def tempdir(self):
        path = tempfile.mkdtemp(prefix="sandbox-")
        self.dirs.append(path)
        return path

    def start(self, argv):
        proc = subprocess.Popen(argv, env=self.env)
        self.procs.append(proc)
        return proc

    def guard(self, name, *args):
        python = self.config["python"]
        return self.start(
            [python, "-E", "-s", os.path.join(self.config["src"], name), *args]
        )

    def wait_for(self, path, proc, what, timeout=5.0):
        """Wait for proc to create path. Failing here names the guard, rather
        than leaving bwrap to trip over a missing bind source."""
        deadline = time.monotonic() + timeout
        while not os.path.exists(path):
            if proc.poll() is not None:
                raise SandboxError(f"{what} exited with status {proc.returncode}")
            if time.monotonic() > deadline:
                raise SandboxError(f"{what} didn't start ({path} missing)")
            time.sleep(0.05)

    def close(self):
        for proc in self.procs:
            if proc.poll() is None:
                proc.terminate()
        for proc in self.procs:
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        for path in self.dirs:
            shutil.rmtree(path, ignore_errors=True)


def ssh_agent_args(guards, cfg, variables):
    """Sandboxed processes only see this proxy's socket, never the real one -
    sign requests other than commit signing are gated behind a popup."""
    socket_path = (
        expand(cfg["socket"], variables)
        if cfg["socket"]
        else os.environ.get("SSH_AUTH_SOCK")
    )
    if not socket_path:
        print(
            "sandbox: no ssh agent ($SSH_AUTH_SOCK unset), none inside", file=sys.stderr
        )
        return []
    sock = os.path.join(guards.tempdir(), "agent.sock")
    proc = guards.guard("ssh-agent-guard", socket_path, sock)
    guards.wait_for(sock, proc, "ssh-agent-guard")
    inside = expand(cfg["path"], variables)
    return ["--bind", sock, inside, "--setenv", "SSH_AUTH_SOCK", inside]


BUS_CONF = """<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:path={sock}</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
"""


def secret_service_args(guards, volume_dir, runtime_dir):
    """Private, ephemeral D-Bus bus with a fake Secret Service, so credentials
    go through libsecret instead of plaintext files. The database itself is
    never bound in, only the socket, so it's only reachable through the API."""
    tmp = guards.tempdir()
    sock = os.path.join(tmp, "bus.sock")
    conf = os.path.join(tmp, "bus.conf")
    ready = os.path.join(tmp, "ready")
    # The database holds credentials in plaintext; secret-service-guard keeps
    # the file itself at 0600, this keeps the directory around it as private.
    os.makedirs(volume_dir, exist_ok=True)
    os.chmod(volume_dir, 0o700)
    db = os.path.join(volume_dir, "secrets.sqlite3")
    Path(conf).write_text(BUS_CONF.format(sock=sock), encoding="utf-8")

    bus = guards.start(
        [
            guards.config["dbusDaemon"],
            f"--config-file={conf}",
            "--nofork",
            "--nopidfile",
        ]
    )
    guard = guards.guard("secret-service-guard", f"unix:path={sock}", db, ready)
    guards.wait_for(sock, bus, "dbus-daemon")
    guards.wait_for(ready, guard, "secret-service-guard")
    inside = f"{runtime_dir}/bus"
    return [
        "--bind",
        sock,
        inside,
        "--setenv",
        "DBUS_SESSION_BUS_ADDRESS",
        f"unix:path={inside}",
    ]


def https_proxy(guards, name, *args):
    """Start an HTTPS-intercepting guard; its HTTPS_PROXY URL once it's up.

    It listens on a free port of the host's loopback, which pasta maps to the
    same port inside. The URL carries a per-launch secret the guard checks,
    since anything on the host's loopback can connect to that port. Its CA
    certificate (the key stays in the guard) goes into the bundle the gh/fj
    wrappers trust, see ca_bundle_args."""
    tmp = guards.tempdir()
    proc = guards.guard(name, tmp, *args)
    info_path = os.path.join(tmp, "proxy.json")
    guards.wait_for(info_path, proc, name)
    info = json.loads(Path(info_path).read_text(encoding="utf-8"))
    port = int(info["port"])
    guards.tcp_ports.append(str(port))
    guards.ca_certs.append(Path(tmp, "ca.pem").read_text(encoding="ascii"))
    return f"http://sandbox:{info['secret']}@127.0.0.1:{port}"


def github_args(guards, volume_dir):
    """gh inside (upstream gh, wrapped to use SANDBOX_GH_PROXY as its
    HTTPS_PROXY) has just a placeholder token; gh-api-proxy, out here,
    intercepts its requests, swaps in the real token - the project's
    (`sandbox --gh-token`) or else the host's - and gates writes behind a
    popup. Never a per-sandbox OAuth login: those hit GitHub's cap on
    simultaneously valid tokens."""
    token_file = os.path.join(volume_dir, GITHUB_TOKEN_FILE)
    try:
        url = https_proxy(guards, "gh-api-proxy", token_file)
    except SandboxError as e:
        print(f"sandbox: {e} - gh inside has no API access", file=sys.stderr)
        return []
    return [
        "--setenv", "SANDBOX_GH_PROXY", url,
        # Only so gh considers itself logged in; never a real credential.
        "--setenv", "GH_TOKEN", "sandbox-placeholder",
    ]  # fmt: skip


def forgejo_args(guards, volume_dir):
    """The same for fj: forgejo-api-proxy adds the project's token for the
    host (`sandbox --fj-token`) or else the one the host's fj is logged in
    with, read per request, so no login is needed to start."""
    tokens_file = os.path.join(volume_dir, FORGEJO_TOKENS_FILE)
    url = https_proxy(guards, "forgejo-api-proxy", tokens_file)
    return ["--setenv", "SANDBOX_FJ_PROXY", url]


def ca_bundle_args(guards, config, runtime_dir):
    """The system CA bundle plus the HTTPS-intercepting guards' CAs, as
    SANDBOX_CA_FILE, which the gh/fj wrappers make their SSL_CERT_FILE.
    Nothing else inside trusts these CAs."""
    if not guards.ca_certs:
        return []
    system = Path(config["fhs"]["ssl"], "certs", "ca-bundle.crt").read_text(
        encoding="utf-8"
    )
    path = os.path.join(guards.tempdir(), "ca-bundle.pem")
    Path(path).write_text(
        "\n".join([system.rstrip("\n"), *guards.ca_certs]), encoding="utf-8"
    )
    inside = f"{runtime_dir}/sandbox-ca.pem"
    return ["--ro-bind", path, inside, "--setenv", "SANDBOX_CA_FILE", inside]


def claude_api_args(guards, key_file, runtime_dir):
    """Claude Code inside sends its API requests as plain HTTP over a socket
    to claude-api-proxy, which adds the project's API key; the managed
    apiKeyHelper gives it a placeholder key."""
    inside = f"{runtime_dir}/claude-api.sock"
    sock = os.path.join(guards.tempdir(), "claude-api.sock")
    proc = guards.guard("claude-api-proxy", sock, key_file)
    guards.wait_for(sock, proc, "claude-api-proxy")
    return [
        "--bind", sock, inside,
        "--setenv", "ANTHROPIC_UNIX_SOCKET", inside,
        # http: plain requests on the socket, which the proxy can read.
        "--setenv", "ANTHROPIC_BASE_URL", "http://api.anthropic.com",
    ]  # fmt: skip


def open_url_args(guards, runtime_dir):
    """No display in here, so xdg-open (/usr/bin/xdg-open, the shim) hands
    http(s) URLs to open-url-guard, which opens them in the host's browser
    behind a popup."""
    sock = os.path.join(guards.tempdir(), "open-url.sock")
    proc = guards.guard("open-url-guard", sock)
    guards.wait_for(sock, proc, "open-url-guard")
    # BROWSER because Python's webbrowser doesn't try xdg-open without a
    # display variable, and npm's open honors it when it can't detect a
    # desktop.
    return [
        "--bind", sock, f"{runtime_dir}/open-url.sock",
        "--setenv", "BROWSER", "/usr/bin/xdg-open",
    ]  # fmt: skip


def exchange_args(volume_dir):
    """Drop box for output of commands the user runs on the host, read back
    instead of pasted. Bound at its host path so a command naming
    $SANDBOX_EXCHANGE's value runs verbatim on either side.

    Read-only: only the host writes here, and a symlink a sandbox planted
    would point that write at any host file. Links left from when it was
    read-write are dropped.
    """
    exchange = os.path.join(volume_dir, "exchange")
    os.makedirs(exchange, exist_ok=True)
    os.chmod(exchange, 0o700)
    for entry in Path(exchange).rglob("*"):
        if entry.is_symlink():
            entry.unlink()
    return ["--ro-bind", exchange, exchange, "--setenv", "SANDBOX_EXCHANGE", exchange]


# -- network ----------------------------------------------------------------


def read_resolv_conf():
    try:
        return Path("/etc/resolv.conf").read_text(encoding="utf-8")
    except OSError:
        return ""


# Where the sandbox sends DNS queries when the host's resolver is on loopback.
# Link-local, so it can't shadow a server the sandbox could otherwise reach.
DNS_FORWARD_ADDR = "169.254.1.53"


def dns_forward(resolv_conf):
    """A host resolver on loopback (systemd-resolved's 127.0.0.53, a local
    dnsmasq or unbound) is out of reach inside: the netns has its own
    loopback, and --map-host-loopback none removes the way to the host's.

    Returns (resolver, text) when the first nameserver is an IPv4 loopback
    one: pasta forwards DNS_FORWARD_ADDR, ports 53 and 853 only, to that
    resolver, and text is resolv.conf for inside with it replaced by
    DNS_FORWARD_ADDR. Other loopback nameservers are dropped, unreachable
    either way. (None, None) when the nameservers work inside as they are.
    """
    resolver = None
    seen_nameserver = False
    lines = []
    for line in resolv_conf.splitlines():
        fields = line.split()
        if len(fields) < 2 or fields[0] != "nameserver":
            lines.append(line)
            continue
        first = not seen_nameserver
        seen_nameserver = True
        try:
            addr = ipaddress.ip_address(fields[1])
        except ValueError:
            lines.append(line)
            continue
        if not addr.is_loopback:
            lines.append(line)
        elif first and addr.version == 4:
            resolver = fields[1]
            lines.append(f"nameserver {DNS_FORWARD_ADDR}")
    if resolver is None:
        return None, None
    return resolver, "\n".join(lines) + "\n"


def host_addresses(ip):
    """The host's global addresses, which get prohibit routes inside."""
    out = subprocess.run(
        [ip, "-o", "addr", "show", "scope", "global"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return [
        line.split()[3].split("/")[0]
        for line in out.splitlines()
        if len(line.split()) > 3
    ]


# Run by pasta, inside its netns, before bwrap: adds the prohibit routes while
# it still has pasta's CAP_NET_ADMIN (bwrap drops it, so the sandbox can't
# remove them), and opens the seccomp filter - here rather than in the
# launcher, since pasta closes inherited fds past stdio before running it.
PASTA_INNER = """
set -e
ip=$1 seccomp=$2 n=$3
shift 3
for addr in "${@:1:n}"; do
	"$ip" route replace prohibit "$addr"
done
shift "$n"
exec 10<"$seccomp"
exec "$@"
"""


def pasta_argv(config, tcp, udp, addrs, bwrap_args, dns_resolver=None):
    """pasta creates a fresh net namespace with a userspace TAP and runs
    bwrap inside it; --config-net has pasta assign address/route/DNS.

    Ports bound inside are forwarded to the host's 127.0.0.1 (the explicit
    range because a bare `-t auto` skips the ephemeral range, where an OAuth
    login's callback listener binds); --host-lo-to-ns-lo delivers them to the
    namespace's loopback, so dev servers on 127.0.0.1 accept them. The host
    side binds 127.0.0.1 only: on *:port a browser opening localhost tries
    ::1 first, gets accepted, then reset.

    The other direction is closed except for the listed host ports: -T/-U
    mirror only those, --map-host-loopback/--map-guest-addr none remove the
    addresses pasta would translate to the host, and the host's own
    addresses get prohibit routes (a snapshot at start).

    The one exception is dns_resolver, a host resolver on loopback (see
    dns_forward), reachable at DNS_FORWARD_ADDR on ports 53 and 853.
    """
    tools = config["tools"]
    dns = []
    if dns_resolver:
        dns = ["--dns-forward", DNS_FORWARD_ADDR, "--dns-host", dns_resolver]
    return [
        tools["pasta"], "--config-net", "--host-lo-to-ns-lo",
        "-t", "127.0.0.1/1-65535,auto",
        "-T", ",".join(tcp) or "none",
        "-U", ",".join(udp) or "none",
        "--map-host-loopback", "none",
        "--map-guest-addr", "none",
        *dns,
        "--",
        tools["bash"], "-c", PASTA_INNER, "bash",
        tools["ip"], config["seccomp"], str(len(addrs)), *addrs,
        tools["bwrap"], "--seccomp", "10", *bwrap_args,
    ]  # fmt: skip


def run(argv, popups=None):
    """Run argv in the foreground; return its exit status.

    With popups (the guards' socket, see popup_relay), argv runs on a pty
    of the launcher's, which shows the guards' popups. Without, it runs on
    the launcher's own terminal (or none), and the guards ask no one.

    SIGINT reaches the whole foreground process group anyway, so it's only
    kept from killing the launcher before cleanup. A handler rather than
    SIG_IGN: an ignored signal stays ignored across exec.
    """
    if popups:
        return popup_relay.Relay(popups).run(argv)
    proc = subprocess.Popen(argv)

    def forward(signum, _frame):
        if proc.poll() is None:
            proc.send_signal(signum)

    signal.signal(signal.SIGINT, lambda *_: None)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGHUP, forward)
    return proc.wait()


# -- main -------------------------------------------------------------------


def inside_env(config, profile, variables, environ):
    """The environment inside: passed-through host vars, then the profile's
    own (PATH included), with $HOME etc. expanded."""
    env = {
        "HOME": variables["HOME"],
        "USER": variables["USER"],
        "LOGNAME": variables["USER"],
        "XDG_RUNTIME_DIR": variables["XDG_RUNTIME_DIR"],
    }
    for name in config["passEnv"]:
        if name in environ:
            env[name] = environ[name]
    for name, value in profile["env"].items():
        env[name] = expand(value, variables)
    return env


def main(argv):
    config_path = argv[1]
    config = json.loads(Path(config_path).read_text(encoding="utf-8"))
    options, command = parse_options(argv[2:])

    # Physical, so a symlink to ~ can't slip past the checks, and the binds
    # name the real path.
    cwd = os.getcwd()
    os.chdir(cwd)
    home = os.path.realpath(os.environ["HOME"])
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or str(os.getuid())
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    variables = {"HOME": home, "USER": user, "XDG_RUNTIME_DIR": runtime_dir}
    check_cwd(cwd, home)
    project = project_root(cwd)

    def in_work_tree(check, *args):
        # The work tree is bound read-write whole, so it gets the same checks
        # (a git repo in ~ would otherwise bind all of the host home).
        if project != cwd:
            try:
                check(project, *args)
            except SandboxError as e:
                raise SandboxError(
                    f"{cwd} is in the git work tree {project}: {e}"
                ) from None

    in_work_tree(check_cwd, home)
    config_path, config = user_config(
        config, config_path, os.environ, home, project, options["reload"]
    )

    state_dir = os.environ.get("SANDBOX_STATE_DIR") or config["stateDir"]
    if state_dir:
        state_dir = expand(state_dir, {**os.environ, **variables})
    else:
        state_dir = os.path.join(
            os.environ.get("XDG_DATA_HOME") or f"{home}/.local/share", "sandbox"
        )
    state_dir = os.path.realpath(state_dir)
    check_outside(cwd, state_dir)
    in_work_tree(check_outside, state_dir)
    volume_dir = os.path.join(state_dir, volume_name(project))
    # Per-project persistent $HOME, nested at $HOME's own path inside the
    # volume dir, so secrets.sqlite3 and exchange/ next to it stay out of
    # reach. Only ever written from inside the sandbox (sandbox-init) - the
    # sandbox can plant symlinks in it, which host-side writes would follow.
    home_volume = volume_dir + home
    os.makedirs(home_volume, exist_ok=True)

    profile = select_profile(config, cwd, project, variables)
    # Per profile: Claude Code on an API key here, or logged in inside.
    claude_api = profile.get("claudeApiKey", False)
    if options["claudeApiKey"]:
        if not claude_api:
            raise SandboxError(
                f"--claude-api-key needs guards.claudeApiKey.enable for this project's profile ({profile.get('name', 'default')})"
            )
        claude_api_key(volume_dir, True)
        return 0
    if options["ghToken"]:
        if not config["guards"]["github"]:
            raise SandboxError("--gh-token needs guards.github.enable")
        set_github_token(volume_dir)
        return 0
    if options["fjToken"]:
        if not config["guards"]["forgejo"]:
            raise SandboxError("--fj-token needs guards.forgejo.enable")
        set_forgejo_token(volume_dir, options["fjToken"])
        return 0
    host_ports = config["hostPorts"]
    if options["projectConfig"] and os.path.lexists(
        os.path.join(project, PROJECT_FILE)
    ):
        manifest = project_manifest(
            config,
            config_path,
            project,
            volume_dir,
            profile["claudeDir"],
            options["reload"],
        )
        approve_project(manifest, volume_dir, os.path.join(project, PROJECT_FILE))
        profile = apply_project(profile, manifest)
        host_ports = host_ports + manifest["hostPorts"]
        if not command and manifest["command"]:
            command = manifest["command"]
    tcp, udp = parse_host_ports(host_port_specs(host_ports, os.environ))
    if claude_api:
        claude_key_file = claude_api_key(volume_dir, False)

    if not os.access(config["seccomp"], os.R_OK):
        raise SandboxError(f"missing seccomp filter {config['seccomp']}")

    env = inside_env(config, profile, variables, os.environ)
    args = base_args(config, env)
    # Must precede every mount under $HOME - bwrap layers mounts in argv
    # order, so those narrower binds shadow the volume, not the other way
    # round.
    args += ["--bind", home_volume, home]

    guards_cfg = config["guards"]
    with ExitStack() as stack:
        guards = Guards(config)
        stack.callback(guards.close)
        # Cleanup on SIGTERM/SIGHUP arriving during startup too.
        for signum in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, lambda signum, _f: sys.exit(128 + signum))

        # Before the guards start, so they get its path.
        popups = None
        if popup_relay.usable():
            path = os.path.join(guards.tempdir(), "popup.sock")
            popups = stack.enter_context(popup_relay.listen(path))
            guards.env[POPUP_ENV] = path

        if guards_cfg["sshAgent"]["enable"]:
            args += ssh_agent_args(guards, guards_cfg["sshAgent"], variables)
            # The hosts the host already trusts, where ssh reads system-wide
            # config; the volume's own ~/.ssh/known_hosts stays writable.
            args += [
                "--ro-bind-try",
                f"{home}/.ssh/known_hosts",
                "/etc/ssh/ssh_known_hosts",
            ]
        if guards_cfg["secretService"]:
            args += secret_service_args(guards, volume_dir, runtime_dir)
        if guards_cfg["github"]:
            args += github_args(guards, volume_dir)
        if guards_cfg["forgejo"]:
            args += forgejo_args(guards, volume_dir)
        args += ca_bundle_args(guards, config, runtime_dir)
        tcp += guards.tcp_ports
        if claude_api:
            args += claude_api_args(guards, claude_key_file, runtime_dir)
        if guards_cfg["openUrl"]:
            args += open_url_args(guards, runtime_dir)

        # Claude Code's managed settings, memory and MCP servers: managed
        # settings outrank user/project/local ones, so ~/.claude in the
        # volume can't override them.
        if profile["claudeDir"]:
            args += ["--ro-bind", profile["claudeDir"], "/etc/claude-code"]

        dns_resolver, resolv_conf = dns_forward(read_resolv_conf())
        if dns_resolver:
            path = os.path.join(guards.tempdir(), "resolv.conf")
            Path(path).write_text(resolv_conf, encoding="utf-8")
            # Mounted over the host's, bound in base_args.
            args += ["--ro-bind", path, "/etc/resolv.conf"]

        args += exchange_args(volume_dir)
        binds = bind_args(profile["binds"], variables, project)
        args += binds

        # sandbox-init links the nix profile and home-manager generation into
        # the volume, then execs the login shell; --login reads
        # .bash_profile/.profile, and the exec trick runs a given command
        # after that same chain.
        init = config["init"]
        args += ["--chdir", cwd, config["python"], "-E", "-s", init["script"]]
        args += [os.path.realpath(p) if os.path.lexists(p) else "" for p in (
            f"{home}/.nix-profile" if init["nixProfile"] else "",
            f"{home}/.local/state/nix/profiles/home-manager" if init["homeManager"] else "",
        )]  # fmt: skip
        shell = config["tools"]["shell"]
        if command:
            args += [shell, "--login", "-c", 'exec "$@"', "bash", *command]
        else:
            args += [shell, "--login"]

        addrs = host_addresses(config["tools"]["ip"])
        return run(pasta_argv(config, tcp, udp, addrs, args, dns_resolver), popups)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except SandboxError as e:
        print(f"sandbox: {e}", file=sys.stderr)
        sys.exit(1)

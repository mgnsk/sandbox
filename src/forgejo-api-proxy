#!/bin/env python3
"""Forgejo API proxy for the sandbox.

Runs outside the sandbox as an intercepting HTTPS_PROXY on the host's
loopback, which the launcher maps into the sandbox. The sandbox's fj (upstream
forgejo-cli, wrapped to set HTTPS_PROXY and trust this proxy's CA) sends every
API request through it, without a token - it isn't logged in inside. This
proxy adds a token, which never enters the sandbox - the project's own for
that host (`sandbox --fj-token HOST`, from the file in argv[2]) if it has one,
else the host fj's - and per request (the mechanics are api_proxy.py's):

  - GET/HEAD are forwarded as-is;
  - everything else waits for the user's approval in a popup.

Only hosts there's a token for are forwarded, over HTTPS. Both sources are
read for each request, so a login on the host (`fj auth add-token`) or a
`sandbox --fj-token` reaches running sandboxes without a restart.
"""

import json
import os
import re
import signal
import sys
from pathlib import Path

import api_proxy

HOST_RE = re.compile(r"^[a-z0-9.-]+(:[0-9]+)?$")


def keys_path():
    """The host fj's keys.json (directories::ProjectDirs' data dir)."""
    data = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    return Path(data) / "forgejo-cli" / "keys.json"


def host_tokens(path):
    """{host[:port]: token} for every instance logged in to in keys.json at
    path; empty if it's missing or unreadable. fj keys hosts by
    host[:port][/subpath]; requests only carry host[:port]."""
    try:
        keys = json.loads(Path(path).read_text(encoding="utf-8"))
        hosts = keys["hosts"]
    except (OSError, ValueError, KeyError, TypeError):
        return {}
    tokens = {}
    if not isinstance(hosts, dict):
        return tokens
    for name, login in hosts.items():
        token = login.get("token") if isinstance(login, dict) else None
        if isinstance(token, str) and token:
            tokens[name.split("/", 1)[0].lower()] = token
    return tokens


class ProxyServer(api_proxy.HttpsProxyServer):
    """forgejo-api-proxy's policy over api_proxy's HTTPS proxy; tokens (a
    callable returning {host: token}) and the rest are injectable for
    tests."""

    name = "forgejo-api-proxy"
    popup_title = "Allow sandboxed Forgejo API write?"

    def __init__(self, tokens=None, **kwargs):
        super().__init__(**kwargs)
        self.tokens = tokens or (lambda: host_tokens(keys_path()))

    def host_allowed(self, host):
        return bool(HOST_RE.match(host)) and host in self.tokens()

    def host_refusal(self, host):
        return (
            f"no token for {host} - on the host, outside the sandbox, run"
            f" `sandbox --fj-token {host}` in the project (a token for this project)"
            f" or `fj --host {host} auth add-token` (the host's, for every project)"
        )

    def authorization(self, host):
        token = self.tokens().get(host)
        return f"token {token}" if token else None


def main():
    """Serve until killed, announcing the port, secret and CA in argv[1];
    argv[2] is the project's {host: token} file."""
    project_file = sys.argv[2]

    def tokens():
        return {**host_tokens(keys_path()), **api_proxy.read_tokens(project_file)}

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    with ProxyServer(tokens) as server:
        server.announce(sys.argv[1])
        server.serve_forever()


if __name__ == "__main__":
    main()

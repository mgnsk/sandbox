#!/bin/env python3
"""xdg-open inside a sandbox, at /usr/bin/xdg-open.

Sends the URL to open-url-guard on the host, which does all the checking:
anything in the sandbox can talk to that socket directly.
"""

import os
import socket
import sys

# xdg-open's own exit codes.
EXIT_SYNTAX = 1
EXIT_FAILED = 4


def main():
    if len(sys.argv) != 2:
        print("usage: xdg-open <http(s) URL>", file=sys.stderr)
        return EXIT_SYNTAX

    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "open-url.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(path)
            sock.sendall(os.fsencode(sys.argv[1]) + b"\n")
            # Blocks for as long as the popup is up.
            with sock.makefile(encoding="utf-8", errors="replace") as reply:
                answer = reply.readline().strip()
    except OSError as e:
        print(f"xdg-open: {path}: {e.strerror}", file=sys.stderr)
        return EXIT_FAILED

    if answer == "ok":
        return 0
    print(f"xdg-open: {answer or 'no answer from open-url-guard'}", file=sys.stderr)
    return EXIT_FAILED


if __name__ == "__main__":
    sys.exit(main())

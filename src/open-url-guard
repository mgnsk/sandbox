#!/bin/env python3
"""Opens web URLs from a sandbox in the host's browser, behind a tmux popup.

The sandbox has no display, so its xdg-open (sandbox-xdg-open) sends the
URL here instead. The host's xdg-open picks a handler by scheme, and for a
path by file type, so it only ever gets a URL that passed validate_url:
anything else could start an arbitrary host application on sandbox-chosen
input.

Protocol: the client sends one line, the URL, and gets back one line, "ok" or
"denied: <reason>".
"""

import os
import shlex
import socket
import struct
import subprocess
import sys
import threading
from urllib.parse import urlsplit

import guard_popup

# From PATH, which the launcher starts with the store's xdg-utils.
XDG_OPEN = "xdg-open"

MAX_URL_SIZE = 4096

APPROVALS = guard_popup.Approvals()


def validate_url(url):
    """Why url must not be opened, or None if it may be offered to the user.

    The checks on the raw text come first: urlsplit silently drops tabs and
    newlines, so it would judge a different URL from the one handed on.
    """
    if not url.isascii() or not url.isprintable() or " " in url:
        # Also what rules out a homograph host: the popup shows the host as
        # its punycode or not at all.
        return "not printable ASCII"
    if "\\" in url:
        # Browsers read it as "/", urlsplit doesn't: the host shown for
        # https://github.com\.evil.example wouldn't be the one loaded.
        return "backslash in URL"
    try:
        parts = urlsplit(url)
        host = parts.hostname
    except ValueError:
        return "malformed URL"
    if parts.scheme not in ("http", "https"):
        return "only http and https URLs can be opened"
    if not host:
        return "no host"
    if "@" in parts.netloc:
        # https://github.com@evil.example reads as github.com in a popup.
        return "user info in URL"
    return None


def peer_pid(sock):
    """PID of the process on the other end of a connected AF_UNIX socket."""
    creds = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    pid, _uid, _gid = struct.unpack("3i", creds)
    return pid


def describe_peer(sock):
    """(cwd, cmdline) of sock's peer, sampled while it still holds the
    connection - see ssh-agent-guard's describe_peer."""
    try:
        pid = peer_pid(sock)
        cwd = os.readlink(f"/proc/{pid}/cwd")
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            parts = f.read().rstrip(b"\0").split(b"\0")
    except OSError:
        return "unknown", "unknown"
    return cwd, " ".join(shlex.quote(p.decode("utf-8", "replace")) for p in parts)


def clean(s):
    """Strip non-printable chars (e.g. terminal escapes) for safe display."""
    return "".join(c if c.isprintable() else "?" for c in s)


def confirm_via_tmux(url, cwd, cmdline):
    """Ask in a tmux popup whether to open url - see guard_popup.ask for the
    answers. Shown whole and wrapped, not truncated: a URL is approved for
    exactly what's on screen."""
    text = (
        "Open in the host's browser?\n\n"
        f"  host:     {clean(urlsplit(url).hostname)}\n"
        f"  cwd:      {clean(cwd)}\n"
        f"  command:  {clean(cmdline)}\n\n"
        f"{url}\n\n"
    )
    return guard_popup.ask("open-url-guard", text, "fold -w 80 {} | less -FRX", 90, "60%")


def open_url(url):
    """Hand a validated URL to the host's xdg-open. In its own session, since
    a browser it starts has to outlive this guard and the sandbox."""
    proc = subprocess.Popen(
        [XDG_OPEN, url],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    threading.Thread(target=proc.wait, daemon=True).start()


def read_line(client):
    """The first line from client, or None if it's too long or isn't UTF-8."""
    buf = b""
    while b"\n" not in buf:
        if len(buf) > MAX_URL_SIZE:
            return None
        chunk = client.recv(MAX_URL_SIZE + 1)
        if not chunk:
            break
        buf += chunk
    line = buf.split(b"\n", 1)[0]
    if len(line) > MAX_URL_SIZE:
        return None
    try:
        return line.decode("utf-8")
    except UnicodeDecodeError:
        return None


def handle_client(client, confirm=confirm_via_tmux, opener=open_url):
    """Answer one client's request to open a URL."""
    try:
        cwd, cmdline = describe_peer(client)
        url = read_line(client)
        reason = "URL too long or not UTF-8" if url is None else validate_url(url)
        if reason is None and not APPROVALS.approve(lambda: confirm(url, cwd, cmdline)):
            reason = "not approved"
        if reason is None:
            try:
                opener(url)
            except OSError as e:
                reason = f"couldn't run {XDG_OPEN}: {e.strerror}"
        client.sendall(b"ok\n" if reason is None else f"denied: {reason}\n".encode())
    except OSError:
        pass
    finally:
        client.close()


def main():
    """Listen on argv[1]."""
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(sys.argv[1])
    server.listen(5)

    while True:
        client, _ = server.accept()
        threading.Thread(target=handle_client, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()

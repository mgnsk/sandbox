#!/bin/env python3
"""GitHub API proxy for the sandbox.

Runs outside the sandbox as an intercepting HTTPS_PROXY on the host's
loopback, which the launcher maps into the sandbox. The sandbox's gh (upstream
gh, wrapped to set HTTPS_PROXY and trust this proxy's CA) sends every API
request through it, with only a placeholder token. This proxy holds the real
token, which never enters the sandbox: the project's own (`sandbox
--gh-token`, from the file in argv[2], read per request) if it has one, else
the host gh's. It decides per request (the mechanics are api_proxy.py's):

  - REST GET/HEAD, and GraphQL documents containing only queries, are
    forwarded as-is;
  - everything else - REST writes, GraphQL mutations/subscriptions, and
    anything it can't parse - waits for the user's approval in a popup.

Only TOKEN_HOSTS are intercepted; the client's Authorization header is always
dropped and the real token added. The download hosts gh is redirected to, and
the web host for git under gh, are tunneled unread. gh and git themselves run inside the sandbox, so nothing
here ever executes them against the sandbox's files.
"""

import json
import re
import signal
import subprocess
import sys
from urllib.parse import urlsplit

from graphql import GraphQLError, parse
from graphql.language import FieldNode, OperationDefinitionNode

import api_proxy
from api_proxy import clean  # noqa: F401 - also this module's API, for tests

API_HOST = "api.github.com"

# Hosts that get the real token: intercepted, each request read.
TOKEN_HOSTS = frozenset({API_HOST, "uploads.github.com"})

# Hosts gh is redirected to for downloads (release assets, archives, run
# logs/artifacts), and github.com for git under gh (which inherits
# HTTPS_PROXY). Tunneled as they are, without a token - the sandbox could
# reach them directly anyway; the list just keeps this from being an open
# proxy (which would also reach the host's own services).
OTHER_HOSTS = frozenset({"github.com", "codeload.github.com"})
OTHER_HOST_SUFFIXES = (".githubusercontent.com", ".blob.core.windows.net")

HOST_RE = re.compile(r"^[a-z0-9.-]+$")

# GraphQL bodies are read in full to classify them; everything else streams.
MAX_GRAPHQL_BODY = 10 * 1024 * 1024


def host_allowed(host):
    """Whether requests to host are intercepted and forwarded."""
    return host in TOKEN_HOSTS


def tunnel_allowed(host):
    """Whether a CONNECT to host (port 443 only) is tunneled unread."""
    if not HOST_RE.match(host) or host in TOKEN_HOSTS:
        return False
    return host in OTHER_HOSTS or host.endswith(OTHER_HOST_SUFFIXES)


def graphql_operations(body):
    """[(type, name, top-level fields)] for each operation in a GraphQL
    request body, plus its variables - or None if it isn't a single,
    parseable GraphQL request."""
    try:
        request = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(request, dict) or not isinstance(request.get("query"), str):
        return None
    try:
        document = parse(request["query"], no_location=True)
    except (GraphQLError, RecursionError):
        return None
    operations = []
    for definition in document.definitions:
        if isinstance(definition, OperationDefinitionNode):
            fields = [
                s.name.value
                for s in definition.selection_set.selections
                if isinstance(s, FieldNode)
            ]
            name = definition.name.value if definition.name else ""
            operations.append((definition.operation.value, name, fields))
    if not operations:
        return None
    return operations, request.get("variables")


def describe_write(method, host, path, graphql_body=None):
    """None if the request only reads, else a description of the write for
    the approval popup. graphql_body is the body of a request to the GraphQL
    endpoint (None for everything else)."""
    target = f"{method} {host}{path}"
    if graphql_body is None:
        return None if method in ("GET", "HEAD") else target

    parsed = graphql_operations(graphql_body)
    if parsed is None:
        return f"{target}\n\n(not a GraphQL request this proxy understands)"
    operations, variables = parsed
    # Any non-query operation counts, whichever one operationName selects.
    if method == "POST" and all(op == "query" for op, _, _ in operations):
        return None
    lines = [target, ""]
    for op, name, fields in operations:
        lines.append(f"{op} {name or '(anonymous)'}: {', '.join(fields) or '-'}")
    if variables:
        lines += ["", "variables:", json.dumps(variables, indent=2, ensure_ascii=False)]
    return "\n".join(lines)


class ProxyServer(api_proxy.HttpsProxyServer):
    """gh-api-proxy's policy over api_proxy's HTTPS proxy; the rest is
    injectable for tests."""

    name = "gh-api-proxy"
    popup_title = "Allow sandboxed GitHub API write?"

    def __init__(self, token, **kwargs):
        """token: the token, or a callable returning it (None for none)."""
        super().__init__(**kwargs)
        self.token = token if callable(token) else lambda: token

    def host_allowed(self, host):
        return host_allowed(host) and bool(self.token())

    def host_refusal(self, host):
        if host_allowed(host):
            return NO_TOKEN
        return super().host_refusal(host)

    def tunnel_allowed(self, host):
        return tunnel_allowed(host)

    def body_limit(self, host, path):
        """GraphQL bodies are read in full to classify them."""
        if host == API_HOST and urlsplit(path).path.rstrip("/") == "/graphql":
            return MAX_GRAPHQL_BODY
        return None

    def describe_write(self, method, host, path, body):
        return describe_write(method, host, path, body)

    def authorization(self, host):
        token = self.token()
        return f"token {token}" if token and host in TOKEN_HOSTS else None


NO_TOKEN = (
    "no GitHub token - on the host, outside the sandbox, run `sandbox --gh-token`"
    " in the project (a token for this project) or `gh auth login` (the host's,"
    " for every project; restart the sandbox after it)"
)


def host_token():
    """The host gh's token, for the proxy's lifetime only; "" if gh isn't
    logged in (or there's no gh)."""
    try:
        result = subprocess.run(
            ["gh", "auth", "token"], capture_output=True, text=True, check=False
        )
    except OSError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def main():
    """Serve until killed, announcing the port, secret and CA in argv[1];
    argv[2] is the project's token file."""
    project_file = sys.argv[2]
    host = host_token()

    def token():
        return api_proxy.read_token(project_file) or host or None

    if not token():
        print(f"sandbox: {NO_TOKEN}", file=sys.stderr)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    with ProxyServer(token) as server:
        server.announce(sys.argv[1])
        server.serve_forever()


if __name__ == "__main__":
    main()

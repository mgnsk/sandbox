#!/bin/env python3
"""GitHub API proxy for the sandbox.

Runs outside the sandbox, listening on a private socket that the sandbox launcher
binds in. The sandbox's gh (patched to honour GH_HTTP_UNIX_SOCKET, see
nix/patches/gh-unix-socket.patch) sends every API request here as plain HTTP, with
only a placeholder token. This proxy holds the real token, which never enters
the sandbox, and decides per request (the mechanics are api_proxy.py's):

  - REST GET/HEAD, and GraphQL documents containing only queries, are
    forwarded as-is;
  - everything else - REST writes, GraphQL mutations/subscriptions, and
    anything it can't parse - waits for the user's approval in a tmux popup.

The client's Authorization header is always dropped; the real token is added
only for TOKEN_HOSTS. gh and git themselves run inside the sandbox, so nothing
here ever executes them against the sandbox's files.
"""

import json
import os
import re
import signal
import subprocess
import sys
from urllib.parse import urlsplit

from graphql import GraphQLError, parse
from graphql.language import FieldNode, OperationDefinitionNode

import api_proxy
from api_proxy import clean  # noqa: F401 - also this module's API, for tests

API_HOST = "api.github.com"

# Hosts that get the real token.
TOKEN_HOSTS = frozenset({API_HOST, "uploads.github.com"})

# Hosts gh is redirected to for downloads (release assets, archives, run
# logs/artifacts). Forwarded without a token - the sandbox could reach them
# directly anyway; the list just keeps this from being an open proxy.
OTHER_HOSTS = frozenset({"github.com", "codeload.github.com"})
OTHER_HOST_SUFFIXES = (".githubusercontent.com", ".blob.core.windows.net")

HOST_RE = re.compile(r"^[a-z0-9.-]+$")

# GraphQL bodies are read in full to classify them; everything else streams.
MAX_GRAPHQL_BODY = 10 * 1024 * 1024


def host_allowed(host):
    """Whether requests to host are forwarded at all."""
    if not HOST_RE.match(host):
        return False
    return host in TOKEN_HOSTS or host in OTHER_HOSTS or host.endswith(OTHER_HOST_SUFFIXES)


def graphql_operations(body):
    """[(type, name, top-level fields)] for each operation in a GraphQL
    request body, plus its variables - or None if it isn't a single,
    parseable GraphQL request."""
    try:
        request = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        return None
    if not isinstance(request, dict) or not isinstance(request.get("query"), str):
        return None
    try:
        document = parse(request["query"], no_location=True)
    except (GraphQLError, RecursionError):
        return None
    operations = []
    for definition in document.definitions:
        if isinstance(definition, OperationDefinitionNode):
            fields = [
                s.name.value
                for s in definition.selection_set.selections
                if isinstance(s, FieldNode)
            ]
            name = definition.name.value if definition.name else ""
            operations.append((definition.operation.value, name, fields))
    if not operations:
        return None
    return operations, request.get("variables")


def describe_write(method, host, path, graphql_body=None):
    """None if the request only reads, else a description of the write for
    the approval popup. graphql_body is the body of a request to the GraphQL
    endpoint (None for everything else)."""
    target = f"{method} {host}{path}"
    if graphql_body is None:
        return None if method in ("GET", "HEAD") else target

    parsed = graphql_operations(graphql_body)
    if parsed is None:
        return f"{target}\n\n(not a GraphQL request this proxy understands)"
    operations, variables = parsed
    # Any non-query operation counts, whichever one operationName selects.
    if method == "POST" and all(op == "query" for op, _, _ in operations):
        return None
    lines = [target, ""]
    for op, name, fields in operations:
        lines.append(f"{op} {name or '(anonymous)'}: {', '.join(fields) or '-'}")
    if variables:
        lines += ["", "variables:", json.dumps(variables, indent=2, ensure_ascii=False)]
    return "\n".join(lines)


class ProxyServer(api_proxy.ProxyServer):
    """gh-api-proxy's policy over api_proxy's server; upstream and confirm
    are injectable for tests."""

    name = "gh-api-proxy"
    popup_title = "Allow sandboxed GitHub API write?"

    def __init__(self, path, token, upstream=api_proxy.open_upstream, confirm=None):
        super().__init__(path, upstream=upstream, confirm=confirm)
        self.token = token

    def host_allowed(self, host):
        return host_allowed(host)

    def body_limit(self, host, path):
        """GraphQL bodies are read in full to classify them."""
        if host == API_HOST and urlsplit(path).path.rstrip("/") == "/graphql":
            return MAX_GRAPHQL_BODY
        return None

    def describe_write(self, method, host, path, body):
        return describe_write(method, host, path, body)

    def authorization(self, host):
        return f"token {self.token}" if host in TOKEN_HOSTS else None


def host_token():
    """The host gh's token, for the proxy's lifetime only."""
    env = {k: v for k, v in os.environ.items() if k != "GH_HTTP_UNIX_SOCKET"}
    result = subprocess.run(
        ["gh", "auth", "token"], env=env, capture_output=True, text=True, check=False
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def main():
    """Serve on argv[1] until killed."""
    listen_path = sys.argv[1]
    token = host_token()
    if not token:
        sys.exit("gh-api-proxy: `gh auth token` gave no token - run `gh auth login` on the host")
    if os.path.exists(listen_path):
        os.unlink(listen_path)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    with ProxyServer(listen_path, token) as server:
        server.serve_forever()


if __name__ == "__main__":
    main()
